# Entorno
ENVIRONMENT=development
DEBUG=true

# Seguridad
SECRET_KEY=genera_uno_con_secrets.token_hex(32)

# Base de datos
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sipa
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sipa_test

# CORS
CORS_ORIGINS=http://localhost:5173

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=sipa@sena.edu.co
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Frontend
FRONTEND_URL=http://localhost:5173

# Almacenamiento
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5